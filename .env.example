# ── AI Employee OS 실제 업무 실행 (OpenAI) ──
# 아래 두 줄이면 기획/프롬프트/이미지/캡션이 실제로 생성됩니다.
EXECUTOR=openai
OPENAI_API_KEY=sk-여기에_본인_키

# 텍스트 모델 (기본: gpt-4o-mini) — 바꾸고 싶을 때만
# EXECUTOR_MODEL=gpt-4o-mini

# 이미지 모델 (기본: gpt-image-1, 실패 시 dall-e-3 자동 시도)
# gpt-image-1 이 계정 검증 문제로 막히면 아래 주석을 풀어 dall-e-3 로 고정하세요.
# EXECUTOR_IMAGE_MODEL=dall-e-3

# ── 참고 ──
# EXECUTOR=mock  → 키 없이 시뮬레이션(이미지는 플레이스홀더)
# EXECUTOR=claude + ANTHROPIC_API_KEY → 텍스트만 Claude 로 (이미지는 미지원)


# ── Grok Studio (쇼핑몰 모델 영상 생성기) ──
# 실행:  python -m grok_studio.app   →  http://127.0.0.1:8100
# 그록(xAI) 키 하나면 옷 분석 + 옷입은사진 + 영상까지 됩니다.
XAI_API_KEY=xai-여기에_본인_키

# 모델 식별자 (xAI 가 스펙을 바꾸면 여기만 교체) — 기본값 그대로 두면 됨
# XAI_VISION_MODEL=grok-2-vision-1212      # 옷 분석(비전)
# XAI_IMAGE_MODEL=grok-2-image-1212        # 옷 입은 사진(text-to-image)
# XAI_VIDEO_MODEL=grok-imagine-video       # 영상(image-to-video)

# 영상 파라미터
# XAI_VIDEO_DURATION=4                      # 초 (짧을수록 저렴, 480p $0.05/초)
# XAI_VIDEO_ASPECT_RATIO=9:16               # 쇼핑몰 세로영상
# XAI_VIDEO_RESOLUTION=480p                 # 480p/720p (그록 최대 720p)

# (선택) 사이트 접속 비밀번호. 비우면 잠금 없음.
# APP_PASSWORD=

# ── 회원제 / 크레딧 ──
# 이 이메일로 가입하면 관리자(크레딧 지급 권한)
ADMIN_EMAIL=banedict84@gmail.com
# 가입 시 무료 크레딧 / 영상 1개당 크레딧 / 크레딧 1개 판매가(원)
# SIGNUP_FREE_CREDITS=2
# CREDIT_COST_VIDEO=1
# CREDIT_PRICE_KRW=3000
# 충전 안내 계좌 문구
# BANK_INFO=입금 계좌: 카카오뱅크 0000-00-0000000 (예금주) · 입금 후 가입 이메일과 함께 연락 주세요.
# 회원/크레딧 저장 DB 경로 (기본: grok_studio/data/grok_studio.db)
# 배포 시 퍼시스턴트 디스크 경로로 지정해야 재배포 후에도 회원이 유지됩니다.
# GROK_STUDIO_DB=/var/data/grok_studio.db
