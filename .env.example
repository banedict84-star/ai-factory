# ── AI Employee OS 실제 업무 실행 (OpenAI) ──
# 아래 두 줄이면 기획/프롬프트/이미지/캡션이 실제로 생성됩니다.
EXECUTOR=openai
OPENAI_API_KEY=sk-여기에_본인_키

# 텍스트 모델 (기본: gpt-4o-mini) — 바꾸고 싶을 때만
# EXECUTOR_MODEL=gpt-4o-mini

# 이미지 모델 (기본: gpt-image-1, 실패 시 dall-e-3 자동 시도)
# gpt-image-1 이 계정 검증 문제로 막히면 아래 주석을 풀어 dall-e-3 로 고정하세요.
# EXECUTOR_IMAGE_MODEL=dall-e-3

# ── 참고 ──
# EXECUTOR=mock  → 키 없이 시뮬레이션(이미지는 플레이스홀더)
# EXECUTOR=claude + ANTHROPIC_API_KEY → 텍스트만 Claude 로 (이미지는 미지원)


# ── 네이버 카페 자동 발행 (src/cafe) ──
# 초안 생성은 Claude 를 쓰므로 ANTHROPIC_API_KEY 가 필요합니다.
ANTHROPIC_API_KEY=sk-ant-여기에_본인_키

# 네이버 개발자센터(https://developers.naver.com)에서 앱 등록 후 발급
NAVER_CLIENT_ID=여기에_클라이언트_ID
NAVER_CLIENT_SECRET=여기에_클라이언트_시크릿
# 앱에 등록한 Callback URL (로그인 리다이렉트). 기본 http://localhost
# NAVER_REDIRECT_URI=http://localhost

# `python -m src.cafe.main login` 으로 받은 값 (장기 사용 권장)
NAVER_REFRESH_TOKEN=
# 단발성으로 쓸 때만 (만료 짧음). refresh_token 이 있으면 비워두세요.
# NAVER_ACCESS_TOKEN=

# 발행할 카페/게시판. CLUB_ID(숫자)를 알면 그걸, 모르면 URL_NAME 을 넣으면 자동 조회.
NAVER_CAFE_CLUB_ID=
# NAVER_CAFE_URL_NAME=cafe.naver.com/뒤에_오는_이름
# 게시판(메뉴) ID — 카페 관리 > 게시판에서 확인
NAVER_CAFE_MENU_ID=
