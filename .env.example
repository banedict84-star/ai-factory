# ── 인스타 모델 컷 자동 게시 (src/) ──
# 기획(Claude) → 이미지(OpenAI) → 호스팅(Imgur) → 게시(인스타) → 반응 조회

# 1) 기획용 (캡션/컨셉)
ANTHROPIC_API_KEY=sk-ant-여기에_본인_키

# 2) 모델 컷 이미지 생성용
OPENAI_API_KEY=sk-여기에_본인_키
# 이미지 모델 (기본 gpt-image-1, 실패 시 dall-e-3 자동 시도)
# EXECUTOR_IMAGE_MODEL=dall-e-3

# 3) 이미지 호스팅 — 인스타는 '공개 URL' 을 요구합니다.
#    imgur : 무료. imgur.com → Settings → Applications 에서 Client ID 발급
#    public: 이미 배포된 서버(/media 등)에 파일이 있을 때 그 URL 사용
#    none  : 게시 건너뜀(생성까지만)
UPLOADER=imgur
IMGUR_CLIENT_ID=여기에_imgur_client_id
# UPLOADER=public 일 때:
# PUBLIC_MEDIA_BASE_URL=https://내앱.onrender.com/media

# 4) 인스타 게시 + 반응 조회용 (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=여기에_장기_액세스_토큰
INSTAGRAM_ACCOUNT_ID=여기에_인스타_비즈니스_계정_ID

# ── 참고: OMS(조직 엔진) 실행용 ──
# EXECUTOR=openai        # 키 없이 시뮬레이션하려면 mock
