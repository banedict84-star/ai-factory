# ── AI Employee OS 실제 업무 실행 ──
# EXECUTOR=claude 이고 아래 키가 있으면 기획/프롬프트/캡션이 실제로 생성됩니다.
# 비워두면(mock) 시뮬레이션으로 동작합니다.
EXECUTOR=mock
EXECUTOR_MODEL=claude-opus-4-8

# Claude API (아이디어·캡션 생성)
ANTHROPIC_API_KEY=

# Instagram Graph API (본인 비즈니스/크리에이터 계정)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# 영상 생성 제공자: placeholder | (추후: 실제 AI 영상 서비스)
VIDEO_PROVIDER=placeholder

# 영상 공개 URL 업로더: none | (추후: s3 | gcs 등)
# none 이면 로컬 파일만 만들고 실제 게시는 건너뜁니다.
UPLOADER=none

# (선택) 실제 AI 영상 제공자용 키 — 나중에 사용
VIDEO_API_KEY=
